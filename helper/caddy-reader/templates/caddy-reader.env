# caddy-reader — written by: caddy-reader install
# The token devtracker uses. Treat it like a password.
READER_TOKEN=REPLACE_ME_64_HEX_CHARS_FROM_CRYPTO_RAND
READER_LISTEN=0.0.0.0:9776
# Where Caddy's admin API is. The default is right unless you moved it.
CADDY_ADMIN=http://127.0.0.1:2019
CADDYFILE=/etc/caddy/Caddyfile
CADDY_BIN=/usr/bin/caddy
