{
  "apps": {
    "http": {
      "servers": {
        "srv0": {
          "listen": [":443"],
          "routes": [
            {
              "match": [{ "host": ["secret.example.com"] }],
              "handle": [
                {
                  "handler": "authentication",
                  "providers": {
                    "http_basic": {
                      "accounts": [
                        { "username": "alice", "password": "$2a$14$aVeryRealBcryptHash" }
                      ]
                    }
                  }
                },
                {
                  "handler": "reverse_proxy",
                  "upstreams": [{ "dial": "10.0.0.9:3000" }],
                  "headers": {
                    "request": { "set": { "X-Api-Key": ["super-secret-upstream-key"] } }
                  }
                }
              ]
            },
            {
              "match": [{ "host": ["dyn.example.com"] }],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "dynamic_upstreams": {
                    "srv": { "name": "internal.service", "credentials": "must-not-appear" }
                  }
                }
              ]
            }
          ]
        }
      }
    }
  },
  "apps_tls": {
    "automation": { "policies": [{ "issuers": [{ "eab": { "mac_key": "secret-hmac" } }] }] }
  }
}
