{
    "apps": {
        "http": {
            "servers": {
                "srv0": {
                    "listen": [
                        ":443"
                    ],
                    "routes": [
                        {
                            "handle": [
                                {
                                    "handler": "authentication"
                                },
                                {
                                    "handler": "reverse_proxy",
                                    "upstreams": [
                                        {
                                            "dial": "10.0.0.9:3000"
                                        }
                                    ]
                                }
                            ],
                            "match": [
                                {
                                    "host": [
                                        "secret.example.com"
                                    ]
                                }
                            ]
                        },
                        {
                            "handle": [
                                {
                                    "dynamic_upstreams": {},
                                    "handler": "reverse_proxy"
                                }
                            ],
                            "match": [
                                {
                                    "host": [
                                        "dyn.example.com"
                                    ]
                                }
                            ]
                        }
                    ]
                }
            }
        }
    }
}
